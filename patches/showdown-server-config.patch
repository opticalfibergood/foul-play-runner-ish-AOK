+/**
+ * customhttpresponse - added by foul-play-ish-aok's offline-showdown build.
+ *
+ * Auto-sends `/trn human` once the client has finished loading, so the
+ * browser lands in the lobby already named, with no console command
+ * needed. This only injects a <script> tag into the already-built client
+ * HTML at request time -- it never modifies any file on disk, and it does
+ * nothing to sprite/data loading or the server's connection target (both
+ * of those are set statically in the client's own config; see
+ * patches/showdown-client-testclient.patch).
+ */
+const fs = require('fs');
+const path = require('path');
+
+exports.customhttpresponse = function (req, res) {
+	const roomidRegex = /^\/(?:[A-Za-z0-9][A-Za-z0-9-]*)\/?(?:\?.*)?$/;
+	if (req.url !== '/' && !roomidRegex.test(req.url)) return false;
+
+	let html;
+	try {
+		html = fs.readFileSync(path.join(__dirname, '../server/static/testclient-new.html'), 'utf8');
+	} catch (err) {
+		// Deliberately loud: a silent fallthrough here previously led to a
+		// confusing, unrelated-looking crash further downstream (the
+		// generic static file server has no 404.html of its own to fall
+		// back to -- see 30-showdown-client.sh for the fix to that part).
+		// If this ever fires, the actual reason (missing file? bad
+		// symlink/path resolution?) should be visible here instead.
+		console.error('customhttpresponse: could not read testclient-new.html:', err.message);
+		return false;
+	}
+
+	const injection = `
+<script>
+(function() {
+	// This used to also force PS.server.protocol to 'http' and explicitly
+	// disconnect+reconnect the connection worker at runtime, to work around
+	// PSServer.protocol being wrongly derived to 'https' whenever
+	// Config.defaultserver.httpport is truthy. That's no longer needed:
+	// patches/showdown-client-testclient.patch now sets httpport to 0
+	// (falsy) in the embedded Config, so protocol computes to 'http'
+	// correctly the moment PSServer is constructed -- there's no wrong
+	// first connection attempt to correct anymore.
+	//
+	// The runtime disconnect+reconnect approach turned out to be actively
+	// harmful, not just unnecessary: calling socket.close() on a still-
+	// CONNECTING WebSocket doesn't close it synchronously -- per spec, the
+	// resulting 'close' event is queued and fires *asynchronously*, i.e.
+	// after the immediately-following reconnect() call had already created
+	// a brand new socket. client-connection-worker.ts's onclose handler
+	// unconditionally nulls out its shared, module-level socket variable
+	// with no check that the event it's handling still belongs to the
+	// current socket -- so that stale, delayed close event would wipe out
+	// the reference to the brand new (possibly already-connected!) socket
+	// and schedule a spurious reconnect on top of it, over and over. That
+	// was the actual mechanism behind "tries to connect over and over and
+	// never works": this script, not the server or foul-play.
+	var tries = 0;
+	var iv = setInterval(function() {
+		tries++;
+		// Safety net only, for the rare case the connection worker fails to
+		// start and the client falls back to its direct (non-worker)
+		// connection path: that path derives its port from httpport
+		// specifically, which is now 0. This is a plain data correction
+		// with no socket/timer side effects -- it doesn't touch any
+		// in-flight connection -- so unlike the old disconnect+reconnect
+		// dance it can't race with anything.
+		if (window.PS && PS.server) PS.server.httpport = PS.server.port;
+		if (window.PS && PS.send && PS.user && !PS.user.named) {
+			clearInterval(iv);
+			PS.send('/trn human');
+		} else if (tries > 200) {
+			clearInterval(iv);
+		}
+	}, 100);
+})();
+</script>`;
+
+	res.writeHead(200, { 'Content-Type': 'text/html; charset=UTF-8' });
+	res.end(html.includes('</body>') ? html.replace('</body>', injection + '</body>') : html + injection);
+	return true;
+};
