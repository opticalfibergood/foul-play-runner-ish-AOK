+            # recovering from on a fair fraction of first launches). This
+            # is a loopback connection to a server process we are
+            # ourselves supervising, so we don't need this library-level
+            # heartbeat to detect a dead peer -- a closed socket or dead
+            # process is already caught elsewhere (recv() raising, or the
+            # launcher's own kill -0 checks). Disabling it removes that
+            # startup race entirely instead of just retrying past it.
+            # Guest/online logins against the real ladder are unaffected.
+            self.websocket = await websockets.connect(
+                self.address, ping_interval=None
+            )
+        else:
+            self.websocket = await websockets.connect(self.address)
