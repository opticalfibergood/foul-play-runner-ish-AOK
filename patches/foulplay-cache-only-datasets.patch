diff --git a/fp/data/sets/base.py b/fp/data/sets/base.py
index 96c7cb8..154d14f 100644
--- a/fp/data/sets/base.py
+++ b/fp/data/sets/base.py
@@ -35,6 +35,22 @@ def get_sets_file(cache_path: str, remote_url: str) -> dict:
         logger.info(f"Loaded from cache: {cache_path}")
         return sets
 
+    if os.environ.get("FOUL_PLAY_CACHE_ONLY") == "1":
+        # Set by this build's start-showdown launcher (same opt-in pattern
+        # as FOUL_PLAY_NOGUEST_LOGIN in fp/websocket_client.py): the
+        # on-device image has no internet access at all, so a cache miss
+        # here can never actually succeed -- fail immediately and clearly
+        # instead of a `requests.get()` hanging or failing with an opaque
+        # connection error partway through a battle. Every other caller
+        # (foul-play run directly, e.g. against the real ladder) never
+        # sets this and is completely unaffected.
+        raise RuntimeError(
+            f"FOUL_PLAY_CACHE_ONLY=1 and no cached file at {cache_path} "
+            f"(would otherwise fetch {remote_url}). This format wasn't "
+            f"pre-warmed into this image -- see WARM_FORMATS in "
+            f"scripts/chroot/36-warm-datasets.sh."
+        )
+
     r = requests.get(remote_url)
     if r.status_code == 200:
         sets = r.json()
