+	<script>
+		// offline-showdown build: PSServer.protocol is derived from
+		// Config.defaultserver.httpport's truthiness ('https' whenever
+		// httpport is set, since that field also doubles as the port
+		// number for the 'http' branch -- no single static Config value
+		// gets both right at once). Fixing PS.server.protocol *after*
+		// client-connection.js has already run is too late: it creates
+		// the worker and fires off a real (wrong-protocol) connection
+		// attempt as soon as it loads, and forcing a disconnect+reconnect
+		// afterwards races that still-in-flight socket's own async
+		// onclose handler, which unconditionally clobbers the worker's
+		// shared connection-state variable -- producing exactly a loop of
+		// spurious connect/disconnect cycles that may never settle.
+		// Instead, wrap Worker so the very *first* 'connect' message the
+		// worker ever receives already carries the corrected protocol;
+		// there is then no bad connection to race against at all.
+		(function() {
+			var OrigWorker = window.Worker;
+			if (!OrigWorker) return;
+			window.Worker = function(url) {
+				var worker = new OrigWorker(url);
+				var origPostMessage = worker.postMessage.bind(worker);
+				worker.postMessage = function(msg) {
+					if (msg && msg.type === 'connect' && msg.server) {
+						msg.server.protocol = 'http';
+					}
+					return origPostMessage(msg);
+				};
+				return worker;
+			};
+		})();
+	</script>
