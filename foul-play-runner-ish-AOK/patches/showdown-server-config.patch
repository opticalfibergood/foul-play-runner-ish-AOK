+/**
+ * customhttpresponse - added by foul-play-ish-aok's offline-showdown build.
+ *
+ * Auto-sends `/trn human` once the client has finished loading, so the
+ * browser lands in the lobby already named, with no console command
+ * needed. This only injects a <script> tag into the already-built client
+ * HTML at request time -- it never modifies any file on disk, and it does
+ * nothing to sprite/data loading or the server's connection target (both
+ * of those are set statically in the client's own config; see
+ * patches/showdown-client-testclient.patch).
+ */
+const fs = require('fs');
+const path = require('path');
+
+exports.customhttpresponse = function (req, res) {
+	const roomidRegex = /^\/(?:[A-Za-z0-9][A-Za-z0-9-]*)\/?(?:\?.*)?$/;
+	if (req.url !== '/' && !roomidRegex.test(req.url)) return false;
+
+	let html;
+	try {
+		html = fs.readFileSync(path.join(__dirname, '../server/static/testclient-new.html'), 'utf8');
+	} catch (err) {
+		// Deliberately loud: a silent fallthrough here previously led to a
+		// confusing, unrelated-looking crash further downstream (the
+		// generic static file server has no 404.html of its own to fall
+		// back to -- see 30-showdown-client.sh for the fix to that part).
+		// If this ever fires, the actual reason (missing file? bad
+		// symlink/path resolution?) should be visible here instead.
+		console.error('customhttpresponse: could not read testclient-new.html:', err.message);
+		return false;
+	}
+
+	const injection = `
+<script>
+(function() {
+	var tries = 0;
+	var fixedProtocol = false;
+	var iv = setInterval(function() {
+		tries++;
+		// PSServer.protocol is wrongly derived to 'https' whenever
+		// Config.defaultserver.httpport is truthy (needed so the 'http'
+		// branch has a real port number to use) -- there is no single
+		// static Config value that gets both protocol and the port right
+		// at once, so this has to be fixed as a runtime mutation after
+		// PSServer is constructed. See patches/showdown-server-config.patch
+		// and showdown-client-testclient.patch for the fuller story.
+		if (!fixedProtocol && window.PS && PS.server && PS.connection) {
+			fixedProtocol = true;
+			PS.server.protocol = 'http';
+			// The page's own first connection attempt already started (with
+			// the wrong protocol) before this script could possibly run --
+			// script tags run in document order, and this one is injected
+			// right before </body>. The worker's own connectToServer() is a
+			// no-op while it still holds a reference to that in-flight/still-
+			// failing socket ('if (socket) return'), so a plain reconnect()
+			// call here can be silently ignored for as long as that stale
+			// attempt takes to time out on its own. Force it to actually drop
+			// first. Worker postMessage calls are processed in the order
+			// sent, so 'disconnect' is guaranteed to run before 'connect'.
+			if (PS.connection.worker) {
+				PS.connection.worker.postMessage({ type: 'disconnect' });
+			}
+			if (PS.connection.socket) {
+				try { PS.connection.socket.close(); } catch (e) {}
+			}
+			PS.connection.socket = null;
+			PS.connection.connected = false;
+			PS.connection.reconnect();
+		}
+		if (window.PS && PS.send && PS.user && !PS.user.named) {
+			clearInterval(iv);
+			PS.send('/trn human');
+		} else if (tries > 200) {
+			clearInterval(iv);
+		}
+	}, 100);
+})();
+</script>`;
+
+	res.writeHead(200, { 'Content-Type': 'text/html; charset=UTF-8' });
+	res.end(html.includes('</body>') ? html.replace('</body>', injection + '</body>') : html + injection);
+	return true;
+};
